############
# [optional]
# Public Ollama API via Caddy
#
# Copy this file to .env.ollama and set a real token:
#   cp .env.ollama.example .env.ollama
#   openssl rand -hex 32
#
# .env.ollama is gitignored and must not be committed.
############

OLLAMA_HOSTNAME=ollama.yourdomain.com
OLLAMA_API_TOKEN=
