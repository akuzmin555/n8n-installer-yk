# RAGFlow Reverse Proxy Configuration
# This file is imported by the main Caddyfile and will NOT be affected by updates

ragflow.ittelo.biz {
    # Reverse proxy to RAGFlow server (nginx on port 80)
    reverse_proxy ragflow-server:80

    # Enable gzip compression for better performance
    encode gzip

    # Access logging (optional, useful for debugging)
    log {
        output file /var/log/caddy/ragflow-access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }

    # Request timeout settings for large file uploads
    request_body {
        max_size 100MB
    }

    # Headers for better security and performance
    header {
        # Enable HSTS (HTTP Strict Transport Security)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"

        # Prevent clickjacking
        X-Frame-Options "SAMEORIGIN"

        # XSS protection
        X-XSS-Protection "1; mode=block"

        # Remove server header for security
        -Server
    }
}
